# Example Environment Variables (DO NOT PUT REAL PASSWORDS IN THIS FILE)
# For Render Backend Web Service:
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here
PORT=8080

# For Vercel Frontend:
VITE_API_BASE_URL=https://<your-render-backend-url>/api/time-entries
